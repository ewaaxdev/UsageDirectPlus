<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BaseTheme" parent="Theme.Material3.DayNight" />

    <style name="AppTheme" parent="BaseTheme">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primaryDark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="primaryTabBackground">@color/primaryLight</item>
        <item name="tabText">@color/tab_text_light</item>
    </style>

    <style name="TextAppearance.Notes.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/glass_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Notes.Meta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/glass_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>